# Gmail address to authenticate with
GMAIL_USER=""

# Gmail App Password (not your regular password) — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_APP_PASSWORD=""

# Gmail label/mailbox to watch. Must have "Show in IMAP" enabled for this
# label under Gmail Settings > Labels.
GMAIL_INBOX="secret-lair"

# Optional — IMAP server address. Defaults to imap.gmail.com:993 if unset.
MAIL_ADDRESS=""
